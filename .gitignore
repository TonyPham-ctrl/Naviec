# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
pyvenv.cfg

# --- Secrets & local config ---
# .env holds real credentials and must never be committed.
# Commit .env.example instead and copy it to .env locally.
.env
.env.*
!.env.example

# --- Data (regenerated by the ingestion pipeline) ---
data/
cache/

# --- Database volumes ---
postgres_data/
docker-data/
.postgres/

# --- LaTeX build artefacts ---
docs/**/*_minted*
docs/**/*.gz
docs/**/*.bbl
docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc

# --- Editors & OS ---
.DS_Store
.codex
