# Copy to .env and fill in real values. .env is git-ignored.
# Consumed by docker-compose.yml and src/storage/postgres_store.py.

DB_NAME=naviec
DB_USER=naviec
DB_PASSWORD=change_me

# Host/port as seen from inside the Docker network.
DB_HOST=postgres
DB_PORT=5432

# Port published on the host machine (used when connecting from your laptop).
DB_PORT_HOST=5433
